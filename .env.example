# ── ConnectHub Backend — Environment Template ────────────────────────────────
#
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` to version control — it is listed in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded 512-bit secret for HMAC-SHA JWT signing.
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by: rate limiting, session management, subscription tier overrides,
#          presence tracking, WebSocket pub/sub, notification delivery
REDIS_HOST=localhost

# ── Eureka Service Registry ──────────────────────────────────────────────────
EUREKA_HOST=service-registry
EUREKA_USER=eureka
EUREKA_PASSWORD=

# ── Spring Boot Admin ─────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Platform Bootstrap Admin Account ─────────────────────────────────────────
# AdminSeeder runs at startup and creates this account ONLY if no admin exists yet.
# After the first run, changing these values has NO effect — the account is already
# in the database. To update the email, use a direct SQL UPDATE on the users table
# or the change-password endpoint. To reset: DELETE the admin row and restart.
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=

# ── AWS S3 (media-service) ────────────────────────────────────────────────────
# IAM credentials with PutObject/GetObject/DeleteObject on the target bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=connecthub-media-bucket
AWS_REGION=ap-south-1
# Optional: CloudFront distribution domain (e.g. d1234abcd.cloudfront.net).
# If set, all uploaded media URLs will use https://<domain>/<key> instead of S3 URLs.
AWS_CLOUDFRONT_DOMAIN=

# ── Email / SMTP (notification-service) ──────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 (auth-service) ────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used for CORS origin whitelisting and OAuth2 redirect URLs.
FRONTEND_URL=http://localhost:5173

# ── Twilio SMS (notification-service) ────────────────────────────────────────
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Razorpay (payment-service) ───────────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_SiTp5ZN7yi5zks
RAZORPAY_KEY_SECRET=V64kV60q74c1KTLV3mtle8K0
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase (notification-service — FCM push notifications) ─────────────────
# Base64-encode your Firebase Admin SDK service account JSON:
#   base64 -w 0 firebase-service-account.json
# Leave empty to disable FCM; the service starts cleanly without it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Zipkin (optional — distributed tracing) ──────────────────────────────────
# Set to the Zipkin collector URL. Defaults to the Docker Compose service.
ZIPKIN_URL=http://zipkin:9411

# ── SonarQube (optional — code quality) ──────────────────────────────────────
# Generate at http://localhost:9000/account/security
SONAR_TOKEN=
