# ── ConnectHub Backend — Environment Template ────────────────────────────────
#
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` to version control — it is listed in .gitignore.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── JWT ───────────────────────────────────────────────────────────────────────
# Base64-encoded 512-bit secret for HMAC-SHA JWT signing.
# Generate with: openssl rand -base64 64
JWT_SECRET=

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used by: rate limiting, session management, subscription tier overrides,
#          presence tracking, WebSocket pub/sub, notification delivery
REDIS_HOST=localhost

# ── Eureka Service Registry ──────────────────────────────────────────────────
EUREKA_HOST=localhost
EUREKA_USER=eureka
EUREKA_PASSWORD=

# ── Spring Boot Admin ─────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Platform Bootstrap Admin Account ─────────────────────────────────────────
# AdminSeeder runs at startup and creates this account ONLY if no admin exists yet.
# After the first run, changing these values has NO effect — the account is already
# in the database. To update the email, use a direct SQL UPDATE on the users table
# or the change-password endpoint. To reset: DELETE the admin row and restart.
PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
PLATFORM_ADMIN_PASSWORD=

# ── Internal service secret ───────────────────────────────────────────────────
# Shared by the gateway and all services (they hide identity headers from anyone without it).
# Leave blank: start-backend.ps1 generates one and saves it here. Or set your own long random value.
INTERNAL_SERVICE_SECRET=

# ── Media storage (media-service) ─────────────────────────────────────────────
# Uploaded files are stored on local disk. Defaults are fine for a local setup; override only if needed.
# MEDIA_STORAGE_DIR=C:/Users/you/connecthub-media
# MEDIA_PUBLIC_BASE_URL=http://localhost:8080

# ── Email / SMTP (notification-service) ──────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 (auth-service) ────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend / Gateway URLs ───────────────────────────────────────────────────
# Used for CORS origin whitelisting and OAuth2 redirect URLs.
FRONTEND_URL=http://localhost:5173
GATEWAY_URL=http://localhost:8080

# ── Twilio SMS (notification-service) ────────────────────────────────────────
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Razorpay (payment-service) ───────────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys — use TEST mode keys for local dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs from https://dashboard.razorpay.com/app/subscriptions/plans
# (create two plans there: one for PREMIUM, one for PLATINUM)
RAZORPAY_PLAN_PREMIUM_ID=
RAZORPAY_PLAN_PLATINUM_ID=

# ── Firebase (notification-service — FCM push notifications) ─────────────────
# Base64-encode your Firebase Admin SDK service account JSON:
#   base64 -w 0 firebase-service-account.json
# Leave empty to disable FCM; the service starts cleanly without it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Zipkin (optional — distributed tracing) ──────────────────────────────────
# Every service tries to export spans here by default. If nothing is
# listening it's harmless log noise, not a functional failure — safe to
# leave as-is even without Zipkin running. See Native_Zipkin.md to stand
# one up locally.
ZIPKIN_URL=http://localhost:9411

# ── SonarQube (optional — code quality) ──────────────────────────────────────
# Generate at http://localhost:9000/account/security
SONAR_TOKEN=

# ── Spring Cloud Config Server (optional, disabled by default) ───────────────
# Not needed for normal operation — no service actually consumes Config
# Server in this project (see Config_Server_Reuse.md). Only fill these in if
# deliberately reactivating it for a demo.
# CONFIG_SERVER_USER=
# CONFIG_SERVER_PASSWORD=
# CONFIG_REPO_USERNAME=
# CONFIG_REPO_PASSWORD=
